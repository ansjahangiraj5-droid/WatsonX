# ─────────────────────────────────────────────────────────────
#  IBM watsonx.ai — backend environment variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# IBM Cloud IAM API key
# Generate at: cloud.ibm.com → Manage → Access (IAM) → API keys
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here

# watsonx.ai Project ID
# Found at: dataplatform.cloud.ibm.com → your project → Manage → General
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Model ID to use for generation
# Recommended options:
#   ibm/granite-13b-instruct-v2
#   meta-llama/llama-3-1-70b-instruct
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# Region where your watsonx.ai instance is hosted
# Options: us-south | eu-gb | eu-de | jp-tok | au-syd
WATSONX_REGION=us-south

# Port the backend server listens on
PORT=3001
